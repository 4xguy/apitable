# Railway Environment Variables Template
# Copy this file and set these variables in Railway dashboard or CLI

# === Database Configuration ===
# MySQL (use Railway MySQL plugin - these will be auto-generated)
DATABASE_URL=${{MySQL.DATABASE_URL}}
MYSQL_HOST=${{MySQL.RAILWAY_PRIVATE_DOMAIN}}
MYSQL_PORT=3306
MYSQL_DATABASE=${{MySQL.MYSQL_DATABASE}}
MYSQL_USERNAME=root
MYSQL_PASSWORD=${{MySQL.MYSQL_ROOT_PASSWORD}}
MYSQL_ROOT_PASSWORD=${{MySQL.MYSQL_ROOT_PASSWORD}}

# Redis (use Railway Redis plugin - these will be auto-generated)
REDIS_URL=${{Redis.REDIS_URL}}
REDIS_HOST=${{Redis.RAILWAY_PRIVATE_DOMAIN}}
REDIS_PORT=6379
REDIS_PASSWORD=${{Redis.REDIS_PASSWORD}}

# === Infrastructure Services ===
# RabbitMQ
RABBITMQ_HOST=rabbitmq.railway.internal
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=apitable
RABBITMQ_PASSWORD=apitable@com

# MinIO
MINIO_HOST=minio.railway.internal
MINIO_PORT=9000
MINIO_ACCESS_KEY=apitable
MINIO_SECRET_KEY=apitable@com
AWS_ENDPOINT=http://minio.railway.internal:9000

# === Internal Service URLs ===
# These use Railway's internal networking
BACKEND_BASE_URL=http://backend-server.railway.internal:8081/api/v1/
BACKEND_SERVER_HOST=backend-server.railway.internal
BACKEND_SERVER_PORT=8081

ROOM_GRPC_URL=room-server.railway.internal:3334
SOCKET_GRPC_URL=room-server.railway.internal:3007
ROOM_SERVER_HOST=room-server.railway.internal
ROOM_SERVER_PORT=3333

WEB_SERVER_HOST=web-server.railway.internal
WEB_SERVER_PORT=8080

DATABUS_SERVER_BASE_URL=http://databus-server.railway.internal:8625
DATABUS_SERVER_HOST=databus-server.railway.internal
DATABUS_SERVER_PORT=8625

IMAGEPROXY_SERVER_HOST=imageproxy-server.railway.internal
IMAGEPROXY_SERVER_PORT=8080

# === Application Configuration ===
# General
ENV=production
NODE_ENV=production
TIMEZONE=UTC
TZ=UTC

# Database
DATABASE_TABLE_PREFIX=apitable_
DB_HOST=${{MySQL.RAILWAY_PRIVATE_DOMAIN}}
DB_PORT=3306
DB_NAME=${{MySQL.MYSQL_DATABASE}}
DB_USERNAME=root
DB_PASSWORD=${{MySQL.MYSQL_ROOT_PASSWORD}}

# OSS Configuration
OSS_CACHE_TYPE=minio
OSS_HOST=assets
OSS_TYPE=QNY1

# API Configuration
API_MAX_MODIFY_RECORD_COUNTS=30

# === Specific Service Variables ===
# Room Server
INSTANCE_MAX_MEMORY=4096M
ENABLE_SOCKET=true
NODE_OPTIONS=--max-old-space-size=2048 --max-http-header-size=80000

# Web Server
WEB_SERVER_PORT=8080
NEXT_PUBLIC_NEXT_API=/nest/v1
NEXT_PUBLIC_BACKEND_API=/api/v1
SSR=true
IS_APITABLE=true
IS_SELFHOST=true

# === Railway-specific ===
# These will be automatically set by Railway
PORT=${{PORT}}
RAILWAY_ENVIRONMENT=${{RAILWAY_ENVIRONMENT}}

# === Public URLs (set after deployment) ===
# Update these with your actual Railway public URLs
PUBLIC_URL=https://your-gateway.up.railway.app
API_BASE_URL=https://your-gateway.up.railway.app/api/v1
SOCKET_URL=wss://your-gateway.up.railway.app